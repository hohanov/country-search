{
    "name": "country-search",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc && node scripts/copy-static.mjs",
        "deploy": "npm run build && npx gh-pages -d ./dist",
        "format:check": "prettier . --check",
        "format": "prettier . --write",
        "lint:fix": "eslint . --fix",
        "lint": "eslint .",
        "prepare": "husky",
        "test": "jest"
    },
    "lint-staged": {
        "*.{js,ts}": [
            "eslint",
            "prettier --check"
        ],
        "*.{js,ts,html,css,json,md}": "prettier --check"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.1.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.2.5",
        "ts-jest": "^29.4.15",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "bootstrap": "^5.3.8",
        "jest": "^30.5.2"
    }
}
